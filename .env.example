# Backend manzili. Bo‘sh qoldirilsa, dev rejimda Vite proksisi ishlatiladi
# (`vite.config.ts` → server.proxy) va CORS muammosi umuman tug‘ilmaydi.
# ⚠️ Bu qiymat YIG‘ISH PAYTIDA kodga yoziladi (`npm run build`),
# ishga tushganda emas. Deploy paneli uni faqat runtime'da bersa,
# bandlga TUSHMAYDI va ilova baribir `/api/v1` ga murojaat qiladi.
#   lokal : bo‘sh qoldiring — Vite proksisi ishlatiladi
#   prod  : https://qurilish-api.mysrv.uz/api/v1
VITE_API_URL=

# Fon xaritasi (basemap) — ko‘chalar va binolar.
# BO‘SH qoldirilsa OpenStreetMap ishlatiladi (kalit talab qilmaydi).
# ⚠️ OSM ning rasmiy plitkalari og‘ir yuklama uchun mo‘ljallanmagan.
# Foydalanuvchi ko‘paysa yoki tashqi internet yopiq bo‘lsa, bu yerga
# o‘z plitka serveringiz yoki MapTiler/Stadia manzilini yozing.
#   o‘chirish uchun: VITE_BASEMAP_URL=off
VITE_BASEMAP_URL=
VITE_BASEMAP_ATTRIBUTION=

# Manzil qidiruvi (geokodlash). Bo‘sh qoldirilsa Nominatim (OSM).
# ⚠️ Nominatim sekundiga bitta so‘rovga ruxsat beradi; ilova buni
# kechiktirish (debounce) bilan hisobga oladi. Xizmat ishlamasa,
# nuqtani xaritadan qo‘lda belgilash baribir mumkin.
VITE_GEOCODER_URL=

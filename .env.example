# Backend manzili. Bo‘sh qoldirilsa, dev rejimda Vite proksisi ishlatiladi
# (`vite.config.ts` → server.proxy) va CORS muammosi umuman tug‘ilmaydi.
# ⚠️ Bu qiymat YIG‘ISH PAYTIDA kodga yoziladi (`npm run build`),
# ishga tushganda emas. Deploy paneli uni faqat runtime'da bersa,
# bandlga TUSHMAYDI va ilova baribir `/api/v1` ga murojaat qiladi.
#   lokal : bo‘sh qoldiring — Vite proksisi ishlatiladi
#   prod  : https://qurilish-api.mysrv.uz/api/v1
VITE_API_URL=

# Fon xaritasi (basemap). BO‘SH qoldirilsa fon chizilmaydi — tuman
# chegaralari va holat ranglari o‘zi yetarli.
# ⚠️ Bepul CARTO/OSM plitkalari ishlab chiqarish uchun mos emas: CARTO
# kalitsiz so‘rovga «API KEY REQUIRED» yozuvini qaytaradi.
VITE_BASEMAP_URL=
VITE_BASEMAP_ATTRIBUTION=
